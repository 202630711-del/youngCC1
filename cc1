<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>오늘 뭐 하지? | 취미 추천 사이트</title>
    <style>
        /* 기본 스타일 리셋 및 폰트 설정 */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
        }

        body {
            background-color: #f8f9fa;
            color: #333;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* 헤더 스타일 */
        header {
            background: linear-gradient(135deg, #6e8efb, #a777e3);
            color: white;
            text-align: center;
            padding: 3rem 1rem;
        }

        header h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }

        header p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        /* 메인 컨테이너 */
        .container {
            max-width: 1000px;
            margin: 2rem auto;
            padding: 0 1rem;
            flex: 1;
        }

        /* 카테고리 필터 버튼 */
        .filter-buttons {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: 8px 16px;
            border: none;
            background-color: #ffffff;
            color: #555;
            border-radius: 20px;
            cursor: pointer;
            font-weight: bold;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }

        .btn:hover, .btn.active {
            background-color: #6e8efb;
            color: white;
        }

        /* 랜덤 추천 섹션 */
        .random-section {
            text-align: center;
            margin-bottom: 3rem;
            background: white;
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }

        .random-btn {
            background-color: #ff6b6b;
            color: white;
            font-size: 1.1rem;
            padding: 12px 24px;
            border-radius: 30px;
            border: none;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .random-btn:hover {
            transform: scale(1.05);
        }

        /* 취미 카드 그리드 */
        .hobby-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }

        .hobby-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            transition: transform 0.2s;
            display: flex;
            flex-direction: column;
        }

        .hobby-card:hover {
            transform: translateY(-5px);
        }

        .hobby-emoji {
            font-size: 4rem;
            text-align: center;
            padding: 1.5rem;
            background-color: #f1f3f5;
        }

        .hobby-info {
            padding: 1.2rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .hobby-category {
            font-size: 0.8rem;
            color: #6e8efb;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .hobby-title {
            font-size: 1.2rem;
            margin-bottom: 8px;
        }

        .hobby-desc {
            font-size: 0.9rem;
            color: #666;
            line-height: 1.4;
        }

        /* 푸터 */
        footer {
            text-align: center;
            padding: 1.5rem;
            background-color: #e9ecef;
            color: #666;
            margin-top: 2rem;
        }
    </style>
</head>
<body>

    <!-- 헤더 -->
    <header>
        <h1>🎯 오늘 뭐 하지?</h1>
        <p>당신의 일상을 다채롭게 만들어 줄 새로운 취미를 찾아보세요!</p>
    </header>

    <!-- 메인 콘텐츠 -->
    <div class="container">
        
        <!-- 랜덤 추천 버튼 섹션 -->
        <div class="random-section">
            <button class="random-btn" onclick="recommendRandom()">🎲 아무거나 하나 추천해줘!</button>
        </div>

        <!-- 카테고리 필터 버튼 -->
        <div class="filter-buttons">
            <button class="btn active" onclick="filterHobbies('all')">전체</button>
            <button class="btn" onclick="filterHobbies('indoor')">집에서 🏠</button>
            <button class="btn" onclick="filterHobbies('outdoor')">야외에서 🌳</button>
            <button class="btn" onclick="filterHobbies('creative')">창작 활동 🎨</button>
        </div>

        <!-- 취미 리스트 카드 그리드 -->
        <div class="hobby-grid" id="hobbyGrid">
            <!-- 자바스크립트로 카드가 동적으로 생성됩니다. -->
        </div>

    </div>

    <!-- 푸터 -->
    <footer>
        <p>© 2026 취미 추천 사이트. All rights reserved.</p>
    </footer>

    <!-- 자바스크립트 -->
    <script>
        // 취미 데이터 배열
        const hobbies = [
            { id: 1, name: '홈 베이킹', category: 'indoor', emoji: '🍞', desc: '와진짜야르한 빵 냄새와 함께 스트레스를 날려보세요구르트.' },
            { id: 2, name: '실내 클라이밍', category: 'outdoor', emoji: '🧗‍♂️', desc: '전신 근육을 사용하며 한 단계씩 올라가는 성취감을 느껴보세요리사.' },
            { id: 3, name: '유튜브 영상 편집', category: 'creative', emoji: '🎬', desc: '나만의 추억을 멋진 영상으로 남기고 공유해보세요실금.' },
            { id: 4, name: '식물 가꾸기 (식집사)', category: 'indoor', emoji: '🪴', desc: '파릇파릇한 식물들을 키우며 마음의 평안을 찾아보세요요현상.' },
            { id: 5, name: '러닝 (마라톤)', category: 'outdoor', emoji: '🏃‍♀️', desc: '운동화만 있다면 지금 당장 시작할 수 있는 건강한 취미입니다람쥐렁이.' },
            { id: 6, name: '오일 파스텔 그림 그리기', category: 'creative', emoji: '🖍️', desc: '부드러운 색감으로 일상의 풍경을 담아보세요플레.' },
            { id: 7, name: '보드게임', category: 'indoor', emoji: '🎲', desc: '친구, 가족들과 함께 두뇌 싸움을 즐겨보세요가매트.' },
            { id: 8, name: '캠핑', category: 'outdoor', emoji: '⛺', desc: '자연 속에서 불멍을 하며 지친 일상을 힐링해보세요들송.' }
        ];

        // 화면에 취미 카드를 뿌려주는 함수
        function displayHobbies(items) {
            const grid = document.getElementById('hobbyGrid');
            grid.innerHTML = ''; // 기존 내용 초기화

            if (items.length === 0) {
                grid.innerHTML = '<p style="grid-column: 1/-1; text-align: center;">해당하는 취미가 없습니다.</p>';
                return;
            }

            items.forEach(hobby => {
                const categoryNames = { indoor: '집에서', outdoor: '야외에서', creative: '창작 활동' };
                
                const card = document.createElement('div');
                card.className = 'hobby-card';
                card.innerHTML = `
                    <div class="hobby-emoji">${hobby.emoji}</div>
                    <div class="hobby-info">
                        <span class="hobby-category">${categoryNames[hobby.category]}</span>
                        <h3 class="hobby-title">${hobby.name}</h3>
                        <p class="hobby-desc">${hobby.desc}</p>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // 카테고리 필터링 함수
        function filterHobbies(category) {
            // 버튼 활성화 스타일 변경
            const buttons = document.querySelectorAll('.filter-buttons .btn');
            buttons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            // 필터링 적용
            if (category === 'all') {
                displayHobbies(hobbies);
            } else {
                const filtered = hobbies.filter(hobby => hobby.category === category);
                displayHobbies(filtered);
            }
        }

        // 랜덤 추천 함수
        function recommendRandom() {
            const randomIndex = Math.floor(Math.random() * hobbies.length);
            const randomHobby = hobbies[randomIndex];
            
            // 알림창으로 간단히 표시 (필요 시 팝업 모달로 변경 가능)
            alert(`🎉 오늘의 추천 취미는 [ ${randomHobby.emoji} ${randomHobby.name} ] 입니다!\n\n"${randomHobby.desc}"`);
        }

        // 페이지 로드 시 전체 취미 목록 표시
        window.onload = () => {
            displayHobbies(hobbies);
        };
    </script>
</body>
</html>
