    // 1. 사운드 효과음 엔진: "여자" & "사나이" 2가지 음원을 랜덤으로 출력
    let soundEnabled = true;
    const soundTracks = [
      "https://www.myinstants.com/media/sounds/yeojja.mp3",
      "https://www.myinstants.com/media/sounds/sanai.mp3"
    ];

    function playMemeSound() {
      if (!soundEnabled) return;

      // 50% 확률로 "여자" / "사나이" 랜덤 선택
      const randomIndex = Math.floor(Math.random() * soundTracks.length);
      const chosenUrl = soundTracks[randomIndex];
      const audioObj = new Audio(chosenUrl);

      try {
        const playPromise = audioObj.play();
        if (playPromise !== undefined) {
          playPromise.catch(() => {
            // 네트워크 차단 시 백업 비프음 재생
            playSynthBeep();
          });
        }
      } catch (e) {
        playSynthBeep();
      }
    }

    // 오디오 대체 폴백 비프음 (Web Audio API)
    function playSynthBeep() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sawtooth";
        osc.frequency.setValueAtTime(440, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(220, ctx.currentTime + 0.2);
        gain.gain.setValueAtTime(0.3, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.2);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.2);
      } catch (err) {}
    }

    function toggleSound() {
      soundEnabled = !soundEnabled;
      const btn = document.getElementById('soundToggleBtn');
