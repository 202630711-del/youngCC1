    let filters = { budget: 'all', place: 'all', purpose: 'all' };

    function render() {
      const searchVal = document.getElementById('searchInput').value.trim().toLowerCase();
      
      const filtered = hobbies.filter(h => {
        const matchBudget = filters.budget === 'all' || h.budget === filters.budget;
        const matchPlace = filters.place === 'all' || h.place === filters.place;
        const matchPurpose = filters.purpose === 'all' || h.purpose === filters.purpose;
        const matchSearch = h.name.toLowerCase().includes(searchVal) || h.tags.some(t => t.toLowerCase().includes(searchVal));

        return matchBudget && matchPlace && matchPurpose && matchSearch;
      });

      document.getElementById('resultCount').textContent = filtered.length;
      const listEl = document.getElementById('hobbyList');
      listEl.innerHTML = '';

      if (filtered.length === 0) {
        listEl.innerHTML = `
          <div class="hobby-card" style="text-align:center; padding:30px;">
            <div class="font-gungsuh" style="font-size:36px; margin-bottom:10px;">예 에 ? ! ?</div>
            <div class="font-batang" style="color:#ff0055; font-size:16px; font-weight:900;">조건에 맞는 취미가 존재하지 않습니다.</div>
          </div>
        `;
        return;
      }

      filtered.forEach(h => {
        const item = document.createElement('div');
        item.className = 'hobby-card';
        item.onclick = () => {
          playMemeSound();
          openModal(h.id);
        };

        item.innerHTML = `
          <div class="hobby-img-wrapper">
            <img src="${h.img}" class="hobby-img" alt="${h.name}" />
            <div class="img-overlay-text font-gungsuh">${h.memeText}</div>
            <div class="img-overlay-badge font-batang">${h.memeSub}</div>
          </div>
          <div class="hobby-title font-gungsuh">${h.icon} ${h.name}</div>
          <div class="hobby-desc font-batang">${h.desc}</div>
          <div>
            ${h.tags.map(t => `<span class="tag-span font-batang">#${t}</span>`).join('')}
          </div>
        `;
        listEl.appendChild(item);
      });
    }

    function setFilter(category, value, btn) {
      playMemeSound();
      filters[category] = value;
      const parent = btn.parentElement;
      const buttons = parent.querySelectorAll('.btn-filter');
      buttons.forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      render();
    }

    function resetFilters() {
      playMemeSound();
      filters = { budget: 'all', place: 'all', purpose: 'all' };
      document.getElementById('searchInput').value = '';
      
      document.querySelectorAll('.filter-card').forEach(card => {
        const btns = card.querySelectorAll('.btn-filter');
        btns.forEach((b, idx) => {
          if(idx === 0) b.classList.add('selected');
          else b.classList.remove('selected');
        });
      });

      render();
    }

    function pickRandom() {
      playMemeSound();
      const idx = Math.floor(Math.random() * hobbies.length);
      openModal(hobbies[idx].id);
    }

    function openModal(id) {
      const h = hobbies.find(item => item.id === id);
      if(!h) return;

      const modal = document.getElementById('modal');
      const body = document.getElementById('modalBody');

      body.innerHTML = `
        <div class="hobby-img-wrapper" style="height:220px;">
          <img src="${h.img}" class="hobby-img" alt="${h.name}" />
          <div class="img-overlay-text font-gungsuh">${h.memeText}</div>
        </div>
        <h2 class="font-gungsuh" style="font-size:26px; color:#ffea00; margin-bottom:10px; font-weight:900;">${h.icon} ${h.name}</h2>
        <p class="hobby-desc font-batang" style="font-size:14px; color:#ffffff; font-weight:bold;">${h.desc}</p>
        <div class="font-gungsuh" style="font-size:20px; color:#00ffcc; font-weight:900; margin-top:10px;">당장 도전해보시든가!</div>
      `;

      modal.classList.remove('hidden');
    }

    function closeModal() {
      playMemeSound();
      document.getElementById('modal').classList.add('hidden');
    }

    window.onload = () => {
      render();
    };
  </script>
